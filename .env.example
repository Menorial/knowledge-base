# ========== DeepSeek V4 Flash（推荐） ==========
# 把下面这行换成你自己的 Key
AI_API_KEY=sk-your-key-here
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-v4-flash
# Embedding 用本地 BGE-small 模型（免费，无需额外 API；512 维）
AI_EMBEDDING_MODEL=local
VECTOR_DIM=512

# ========== 其他可选 ==========
# OpenAI:
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
# AI_EMBEDDING_MODEL=text-embedding-3-small
# VECTOR_DIM=1536

# 通义千问:
# AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# AI_MODEL=qwen-plus
# AI_EMBEDDING_MODEL=text-embedding-v3
# VECTOR_DIM=1024

# 注意：VECTOR_DIM 必须与 Embedding 模型输出维度一致！
#   local(BGE-small-zh-v1.5)=512 | text-embedding-3-small=1536 | text-embedding-v3=1024
# 修改 VECTOR_DIM 后启动会自动重建向量表，需在「文档管理」页重新建立索引。

DB_PATH=data/knowledge.db

FILE_STORAGE_DIR=data/files
MAX_FILE_SIZE=20971520
ALLOWED_EXTENSIONS=.md,.txt,.pdf,.docx,.html

BACKUP_DIR=backup
BACKUP_KEEP_DAYS=7

# 本地 Embedding 模型下载（首次约 100MB）
HF_ENDPOINT=https://hf-mirror.com
# 设为 1 时只读本地缓存，不联网下载
BGE_OFFLINE=0
